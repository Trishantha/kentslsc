generator client {
  provider = "prisma-client-js"
  output   = "../dist/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  BUSINESS_OWNER
  GUEST
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum FundraiserStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  REJECTED
}

enum FundraiserCategory {
  CHARITY
  SPORTS
  COMMUNITY
  MEMORIAL
  MEDICAL
  OTHER
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOCKOUT
  LOCKOUT_CLEARED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  SESSION_REVOKED
  REFRESH_REUSE_DETECTED
  ADMIN_USER_CREATED
  ROLE_CHANGED
}

model User {
  id            String    @id @default(uuid())
  name          String
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  address       Json?     @db.JsonB
  role          UserRole  @default(GUEST)
  refreshToken  String?   @map("refresh_token")
  // Timestamp only, deliberately no parallel boolean: two sources of truth for
  // the same fact drift. Callers derive `emailVerified` from this being non-null.
  emailVerifiedAt   DateTime? @map("email_verified_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  memberships           Membership[]
  tickets               Ticket[]
  businessListings      BusinessListing[]
  forumTopics           ForumTopic[]
  forumPosts            ForumPost[]
  donations             Donation[]
  blogPosts             BlogPost[]            @relation("AuthorBlogPosts")
  organizedFundraisers  Fundraiser[]          @relation("FundraiserOrganizer")
  fundraiserUpdates     FundraiserUpdate[]

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  authEvents              AuthEvent[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// One row per signed-in device. Replaces the single `users.refresh_token`
/// slot, which meant signing in anywhere silently killed every other session.
///
/// Rotation mutates this row in place and shifts the previous hash into
/// `prevRefreshTokenHash`; a token that matches *that* is a replay, which means
/// either the user or an attacker is using a stolen copy, so the whole session
/// is revoked. `id` doubles as the `sid` JWT claim and is stable across
/// rotations, which is what lets us revoke access tokens per device.
model Session {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  prevRefreshTokenHash String?   @unique @map("prev_refresh_token_hash")
  userAgent            String?   @map("user_agent")
  ipHash               String?   @map("ip_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  lastUsedAt           DateTime  @default(now()) @map("last_used_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the sha256 of the emailed token is stored, so a database read never
/// yields a usable credential.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  email      String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Security audit trail. Records outcomes, never counters — per-attempt
/// counters live in Redis so a login spray can't serialise writes against the
/// users table (the pool runs at connection_limit=1).
model AuthEvent {
  id        String        @id @default(uuid())
  userId    String?       @map("user_id")
  email     String?
  type      AuthEventType
  ipHash    String?       @map("ip_hash")
  userAgent String?       @map("user_agent")
  metadata  Json?         @db.JsonB
  createdAt DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

model MembershipType {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  isFree         Boolean  @default(false) @map("is_free")
  durationMonths Int      @map("duration_months")
  benefits       String[] @default([])
  features       String[] @default([])
  autoActivate   Boolean  @default(false) @map("auto_activate")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  memberships Membership[]

  @@map("membership_types")
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  membershipTypeId   String           @map("membership_type_id")
  startDate          DateTime         @map("start_date")
  endDate            DateTime         @map("end_date")
  status             MembershipStatus @default(PENDING)
  dependantsJson     Json?            @map("dependants_json")
  membershipId       String           @unique @map("membership_id")
  membershipCardUrl  String?          @map("membership_card_url")
  qrCodeValue        String?          @unique @map("qr_code_value")
  issuedAt           DateTime         @default(now()) @map("issued_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  user           User           @relation(fields: [userId], references: [id])
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([membershipId])
  @@map("memberships")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  location      String?
  startDatetime DateTime @map("start_datetime")
  endDatetime   DateTime @map("end_datetime")
  ticketPrice   Decimal  @default(0) @map("ticket_price") @db.Decimal(10, 2)
  isFree        Boolean  @default(false) @map("is_free")
  maxTickets    Int?     @map("max_tickets")
  imageUrl      String?  @map("image_url")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tickets Ticket[]

  @@index([startDatetime])
  @@index([isPublished])
  @@map("events")
}

model Ticket {
  id              String      @id @default(uuid())
  eventId         String      @map("event_id")
  userId          String      @map("user_id")
  purchaseDatetime DateTime   @default(now()) @map("purchase_datetime")
  qrCodeValue     String      @unique @map("qr_code_value")
  status          TicketStatus @default(VALID)
  paymentId       String?     @map("payment_id")
  stripeSessionId String?     @map("stripe_session_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([qrCodeValue])
  @@index([paymentId])
  @@map("tickets")
}

model BusinessListing {
  id             String    @id @default(uuid())
  ownerUserId    String    @map("owner_user_id")
  businessName   String    @map("business_name")
  logoUrl        String?   @map("logo_url")
  description    String?
  servicesText   String?   @map("services_text")
  websiteUrl     String?   @map("website_url")
  email          String?
  phone          String?
  address        String?
  category       String?
  isPaid         Boolean   @default(false) @map("is_paid")
  isPromoted     Boolean   @default(false) @map("is_promoted")
  promotedUntil  DateTime? @map("promoted_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner  User    @relation(fields: [ownerUserId], references: [id])
  jobAds JobAd[]

  @@index([ownerUserId])
  @@index([isPromoted])
  @@index([category])
  @@map("business_listings")
}

model JobAd {
  id                String    @id @default(uuid())
  businessListingId String?   @map("business_listing_id")
  title             String
  description       String?
  location          String?
  salaryRange       String?   @map("salary_range")
  contactEmail      String?   @map("contact_email")
  closingDate       DateTime? @map("closing_date")
  isPublished       Boolean   @default(false) @map("is_published")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  businessListing BusinessListing? @relation(fields: [businessListingId], references: [id])

  @@index([businessListingId])
  @@index([closingDate])
  @@index([isPublished])
  @@map("job_ads")
}

model ForumCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  topics ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  userId      String   @map("user_id")
  title       String
  content     String
  aiSummary   String?  @map("ai_summary")
  tags        String[] @default([])
  isFlagged   Boolean  @default(false) @map("is_flagged")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category ForumCategory @relation(fields: [categoryId], references: [id])
  user     User          @relation(fields: [userId], references: [id])
  posts    ForumPost[]

  @@index([categoryId])
  @@index([userId])
  @@map("forum_topics")
}

model ForumPost {
  id        String   @id @default(uuid())
  topicId   String   @map("topic_id")
  userId    String   @map("user_id")
  content   String
  isFlagged Boolean  @default(false) @map("is_flagged")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@index([topicId])
  @@index([userId])
  @@map("forum_posts")
}

model Fundraiser {
  id               String              @id @default(uuid())
  title            String
  description      String?
  targetAmount     Decimal             @map("target_amount") @db.Decimal(12, 2)
  raisedAmount     Decimal             @default(0) @map("raised_amount") @db.Decimal(12, 2)
  totalDonors      Int                 @default(0) @map("total_donors")
  imageUrl         String?             @map("image_url")
  imagePath        String?             @map("image_path")
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  isActive         Boolean             @default(true) @map("is_active")
  status           FundraiserStatus    @default(PENDING_APPROVAL)
  category         FundraiserCategory  @default(CHARITY)
  organizerId      String?             @map("organizer_id")
  rejectionReason  String?             @map("rejection_reason")
  approvedAt       DateTime?           @map("approved_at")
  aiSummary        String?             @map("ai_summary")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  donations  Donation[]
  updates    FundraiserUpdate[]
  organizer  User?               @relation("FundraiserOrganizer", fields: [organizerId], references: [id])

  @@index([status])
  @@index([isActive])
  @@index([endDate])
  @@index([organizerId])
  @@map("fundraisers")
}

model Donation {
  id            String    @id @default(uuid())
  fundraiserId  String    @map("fundraiser_id")
  userId        String?   @map("user_id")
  amount        Decimal   @db.Decimal(12, 2)
  paymentId     String?   @map("payment_id")
  message       String?
  displayName   String?   @map("display_name")
  isAnonymous   Boolean   @default(false) @map("is_anonymous")
  isOffline     Boolean   @default(false) @map("is_offline")
  donorEmail    String?   @map("donor_email")
  isVerified    Boolean   @default(false) @map("is_verified")
  donatedAt     DateTime  @default(now()) @map("donated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  fundraiser  Fundraiser  @relation(fields: [fundraiserId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([fundraiserId])
  @@index([userId])
  @@index([paymentId])
  @@map("donations")
}

model FundraiserUpdate {
  id           String    @id @default(uuid())
  fundraiserId String    @map("fundraiser_id")
  authorId     String    @map("author_id")
  title        String
  content      String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  fundraiser  Fundraiser  @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id])

  @@index([fundraiserId])
  @@map("fundraiser_updates")
}

model BlogPost {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String
  authorUserId  String    @map("author_user_id")
  publishedAt  DateTime? @map("published_at")
  isPublished   Boolean   @default(false) @map("is_published")
  imageUrl      String?   @map("image_url")
  aiTldr        String?   @map("ai_tldr")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  author User @relation(fields: [authorUserId], references: [id], name: "AuthorBlogPosts")

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model ContactMessage {
  id             String        @id @default(uuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String
  handledStatus  ContactStatus @default(NEW) @map("handled_status")
  aiFaqResponse  String?       @map("ai_faq_response")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  @@index([handledStatus])
  @@index([email])
  @@map("contact_messages")
}

model AiCache {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("ai_cache")
}

model SearchIndex {
  id        String   @id @default(uuid())
  entityType String  @map("entity_type")
  entityId  String   @map("entity_id")
  title     String
  content   String
  embedding String?  // Stored as JSON string for flexibility
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@map("search_index")
}

model SitePage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  isHome          Boolean  @default(false) @map("is_home")
  metaDescription String?  @map("meta_description")
  ogImageUrl      String?  @map("og_image_url")
  blocks          Json
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isHome])
  @@index([isPublished])
  @@map("site_pages")
}

model HeroConfig {
  // The live column is a real `uuid`, not `text`. Declaring @db.Uuid aligns the
  // schema to the database so Prisma stops trying to rewrite this primary key;
  // the alternative (rewriting the column) would be a destructive no-op.
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaType           String   @default("video") @map("media_type")
  imageUrl            String?  @map("image_url")
  videoUrl            String?  @map("video_url")
  overlayStyle        String   @default("noise") @map("overlay_style")
  overlayOpacity      Int      @default(75) @map("overlay_opacity")
  videoOverlayOpacity Int      @default(75) @map("video_overlay_opacity")
  videoPlaybackRate   Float    @default(1) @map("video_playback_rate")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("hero_config")
}

model PaymentSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            String   @default("stripe")
  stripeSecretKey     String?  @map("stripe_secret_key")
  stripeWebhookSecret String?  @map("stripe_webhook_secret")
  stripePublishableKey String?  @map("stripe_publishable_key")
  paypalClientId      String?  @map("paypal_client_id")
  paypalClientSecret  String?  @map("paypal_client_secret")
  paypalApiBaseUrl    String?  @map("paypal_api_base_url")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model CommitteeMember {
  id           String    @id @default(uuid())
  name         String
  position     String
  roleKey      String    @unique @map("role_key")
  photoUrl     String?   @map("photo_url")
  photoPath    String?   @map("photo_path")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@map("committee_members")
}
