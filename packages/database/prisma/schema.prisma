generator client {
  provider = "prisma-client-js"
  output   = "../dist/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  BUSINESS_OWNER
  GUEST
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentSourceType {
  TICKET
  MEMBERSHIP
  DONATION
  DIRECTORY_PROMOTION
  JOB_PUBLISH
  MANUAL
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum FundraiserStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  REJECTED
}

enum FundraiserCategory {
  CHARITY
  SPORTS
  COMMUNITY
  MEMORIAL
  MEDICAL
  OTHER
}

enum EventCategory {
  CULTURAL
  SOCIAL
  SPORTS
  CHARITY
  EDUCATIONAL
  COMMUNITY
  FAMILY
  RELIGIOUS
  FOOD
  ENTERTAINMENT
  BUSINESS
  OTHER
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOCKOUT
  LOCKOUT_CLEARED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  SESSION_REVOKED
  REFRESH_REUSE_DETECTED
  ADMIN_USER_CREATED
  ROLE_CHANGED
  USER_STATUS_CHANGED
}

enum Permission {
  MANAGE_USERS
  MANAGE_MEMBERSHIPS
  SCAN_MEMBERSHIPS
  MANAGE_EVENTS
  MANAGE_TICKETS
  MANAGE_DIRECTORY
  MANAGE_JOBS
  MANAGE_FUNDRAISERS
  MANAGE_BLOG
  MANAGE_FORUM
  MANAGE_CONTACT_MESSAGES
  MANAGE_SITE_SETTINGS
  MANAGE_HERO
  MANAGE_PAGES
  MANAGE_PAYMENTS
  MANAGE_COMMITTEE
  VIEW_ADMIN_DASHBOARD
}

enum MembershipScanResult {
  VALID
  EXPIRED
  INACTIVE
  NOT_FOUND
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  address       Json?     @db.JsonB
  role          UserRole  @default(GUEST)
  status        UserStatus @default(ACTIVE)
  refreshToken  String?   @map("refresh_token")
  // Stable Stripe Customer id for the user; using it in Checkout locks the email field.
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  // Optional back-office role that provides a default permission set.
  backOfficeRoleId String?   @map("back_office_role_id")
  // Timestamp only, deliberately no parallel boolean: two sources of truth for
  // the same fact drift. Callers derive `emailVerified` from this being non-null.
  emailVerifiedAt   DateTime? @map("email_verified_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  memberships           Membership[]
  tickets               Ticket[]
  businessListings      BusinessListing[]
  forumTopics           ForumTopic[]
  forumPosts            ForumPost[]
  donations             Donation[]
  blogPosts             BlogPost[]            @relation("AuthorBlogPosts")
  organizedFundraisers  Fundraiser[]          @relation("FundraiserOrganizer")
  fundraiserUpdates     FundraiserUpdate[]
  payments              Payment[]

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  authEvents              AuthEvent[]
  userPermissions         UserPermission[]
  membershipScans         MembershipScan[]
  backOfficeRole          BackOfficeRole?       @relation(fields: [backOfficeRoleId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role])
  @@index([backOfficeRoleId])
  @@map("users")
}

model BackOfficeRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions BackOfficeRolePermission[]
  users       User[]
  sourcePermissions UserPermission[] @relation("SourceRolePermissions")

  @@map("back_office_roles")
}

model BackOfficeRolePermission {
  id        String     @id @default(uuid())
  roleId    String     @map("role_id")
  permission Permission @map("permission")

  role BackOfficeRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
  @@map("back_office_role_permissions")
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  permission Permission @map("permission")
  // If the permission was granted because of a role, the source role is tracked
  // so it can be distinguished from directly-assigned permissions.
  sourceRoleId String?  @map("source_role_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRole BackOfficeRole?  @relation("SourceRolePermissions", fields: [sourceRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
  @@map("user_permissions")
}

/// One row per signed-in device. Replaces the single `users.refresh_token`
/// slot, which meant signing in anywhere silently killed every other session.
///
/// Rotation mutates this row in place and shifts the previous hash into
/// `prevRefreshTokenHash`; a token that matches *that* is a replay, which means
/// either the user or an attacker is using a stolen copy, so the whole session
/// is revoked. `id` doubles as the `sid` JWT claim and is stable across
/// rotations, which is what lets us revoke access tokens per device.
model Session {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  prevRefreshTokenHash String?   @unique @map("prev_refresh_token_hash")
  userAgent            String?   @map("user_agent")
  ipHash               String?   @map("ip_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  lastUsedAt           DateTime  @default(now()) @map("last_used_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the sha256 of the emailed token is stored, so a database read never
/// yields a usable credential.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  email      String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Security audit trail. Records outcomes, never counters — per-attempt
/// counters live in Redis so a login spray can't serialise writes against the
/// users table (the pool runs at connection_limit=1).
model AuthEvent {
  id        String        @id @default(uuid())
  userId    String?       @map("user_id")
  email     String?
  type      AuthEventType
  ipHash    String?       @map("ip_hash")
  userAgent String?       @map("user_agent")
  metadata  Json?         @db.JsonB
  createdAt DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

model MembershipType {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  isFree         Boolean  @default(false) @map("is_free")
  durationMonths Int      @map("duration_months")
  maxIssuances   Int?     @map("max_issuances")
  benefits       String[] @default([])
  features       String[] @default([])
  autoActivate   Boolean  @default(false) @map("auto_activate")
  stripeProductId String?  @map("stripe_product_id")
  stripePriceId   String?  @map("stripe_price_id")
  isPaused       Boolean  @default(false) @map("is_paused")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  memberships Membership[]

  @@map("membership_types")
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  membershipTypeId   String           @map("membership_type_id")
  startDate          DateTime         @map("start_date")
  endDate            DateTime         @map("end_date")
  status             MembershipStatus @default(PENDING)
  dependantsJson     Json?            @map("dependants_json")
  membershipId       String           @unique @map("membership_id")
  membershipCardUrl  String?          @map("membership_card_url")
  qrCodeValue        String?          @unique @map("qr_code_value")
  paidAt             DateTime?        @map("paid_at")
  paymentMethod      String?          @map("payment_method")
  // Prorated credit carried over from a previous paid membership when downgrading.
  // Stored in the major currency unit (e.g. GBP) and converted to free months on the new plan.
  creditAmountApplied Decimal?        @map("credit_amount_applied") @db.Decimal(10, 2)
  creditMonthsGranted Int?            @map("credit_months_granted")
  stripeCustomerId    String?         @map("stripe_customer_id")
  stripeSubscriptionId String?        @map("stripe_subscription_id")
  stripePriceId       String?         @map("stripe_price_id")
  subscriptionStatus  String?         @map("subscription_status")
  issuedAt           DateTime         @default(now()) @map("issued_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  user           User           @relation(fields: [userId], references: [id])
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])
  scans          MembershipScan[]
  payments       Payment[]

  @@index([userId])
  @@index([status])
  @@index([membershipId])
  @@map("memberships")
}

model MembershipScan {
  id              String               @id @default(uuid())
  scannedValue    String               @map("scanned_value")
  membershipId    String?              @map("membership_id")
  result          MembershipScanResult @map("result")
  memberName      String?              @map("member_name")
  membershipType  String?              @map("membership_type")
  scannedById     String               @map("scanned_by_id")
  scannedAt       DateTime             @default(now()) @map("scanned_at")

  membership Membership? @relation(fields: [membershipId], references: [membershipId])
  scannedBy  User        @relation(fields: [scannedById], references: [id])

  @@index([membershipId])
  @@index([scannedById])
  @@index([scannedAt])
  @@map("membership_scans")
}

model Event {
  id            String        @id @default(uuid())
  title         String
  description   String?
  location      String?
  startDatetime DateTime      @map("start_datetime")
  endDatetime   DateTime      @map("end_datetime")
  ticketPrice   Decimal       @default(0) @map("ticket_price") @db.Decimal(10, 2)
  isFree        Boolean       @default(false) @map("is_free")
  maxTickets    Int?          @map("max_tickets")
  category      EventCategory @default(OTHER) @map("category")
  imageUrl      String?       @map("image_url")
  posterImageUrl String?      @map("poster_image_url")
  posterImages  Json?         @map("poster_images") @db.JsonB
  ticketDesign  Json?         @map("ticket_design") @db.JsonB
  isPublished   Boolean       @default(false) @map("is_published")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  tickets Ticket[]
  payments Payment[]

  @@index([startDatetime])
  @@index([isPublished])
  @@index([category])
  @@map("events")
}

model Ticket {
  id              String      @id @default(uuid())
  eventId         String      @map("event_id")
  userId          String      @map("user_id")
  purchaseDatetime DateTime   @default(now()) @map("purchase_datetime")
  qrCodeValue     String      @unique @map("qr_code_value")
  serialNumber    Int?        @map("serial_number")
  ticketNumber    String?     @unique @map("ticket_number")
  status          TicketStatus @default(VALID)
  paymentId       String?     @map("payment_id")
  stripeSessionId String?     @unique @map("stripe_session_id")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  payments Payment[]

  @@index([eventId])
  @@index([userId])
  @@index([qrCodeValue])
  @@index([paymentId])
  @@map("tickets")
}

model Payment {
  id                   String           @id @default(uuid())
  userId               String?          @map("user_id")
  paymentChannel       String           @map("payment_channel")
  paymentMethod        String?          @map("payment_method")
  paymentStatus        PaymentStatus    @default(PENDING) @map("payment_status")
  providerPaymentId    String?          @map("provider_payment_id")
  providerCheckoutId   String?          @map("provider_checkout_id")
  currency             String           @default("GBP")
  grossAmount          Decimal          @default(0) @map("gross_amount") @db.Decimal(12, 2)
  processingFee        Decimal          @default(0) @map("processing_fee") @db.Decimal(12, 2)
  netAmount            Decimal          @default(0) @map("net_amount") @db.Decimal(12, 2)
  refundedAmount       Decimal?         @map("refunded_amount") @db.Decimal(12, 2)
  refundReason         String?          @map("refund_reason")
  refundedAt           DateTime?        @map("refunded_at")
  description          String?
  notes                String?
  payerName            String?          @map("payer_name")
  payerEmail           String?          @map("payer_email")
  payerPhone           String?          @map("payer_phone")
  payerAddressLine1    String?          @map("payer_address_line1")
  payerAddressLine2    String?          @map("payer_address_line2")
  payerCity            String?          @map("payer_city")
  payerPostcode        String?          @map("payer_postcode")
  payerCountry         String?          @map("payer_country")
  purchasedAt          DateTime?        @map("purchased_at")
  sourceType           PaymentSourceType @map("source_type")
  sourceId             String?          @map("source_id")
  eventId              String?          @map("event_id")
  ticketId             String?          @map("ticket_id")
  membershipId         String?          @map("membership_id")
  donationId           String?          @map("donation_id")
  businessListingId    String?          @map("business_listing_id")
  jobAdId              String?          @map("job_ad_id")
  receiptNumber        String?          @unique @map("receipt_number")
  metadata             Json?            @db.JsonB
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ticket          Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  membership      Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  donation        Donation?        @relation(fields: [donationId], references: [id], onDelete: SetNull)
  businessListing BusinessListing? @relation(fields: [businessListingId], references: [id], onDelete: SetNull)
  jobAd           JobAd?           @relation(fields: [jobAdId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paymentStatus])
  @@index([paymentChannel])
  @@index([sourceType])
  @@index([sourceId])
  @@index([ticketId])
  @@index([providerCheckoutId])
  @@index([providerPaymentId])
  @@index([receiptNumber])
  @@index([purchasedAt])
  @@index([createdAt])
  @@map("payments")
}

model ReceiptNumberSequence {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  number    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt_number_sequences")
}

model BusinessListing {
  id             String    @id @default(uuid())
  ownerUserId    String    @map("owner_user_id")
  businessName   String    @map("business_name")
  logoUrl        String?   @map("logo_url")
  description    String?
  servicesText   String?   @map("services_text")
  websiteUrl     String?   @map("website_url")
  email          String?
  phone          String?
  address        String?
  category       String?
  isPaid         Boolean   @default(false) @map("is_paid")
  isPromoted     Boolean   @default(false) @map("is_promoted")
  promotedUntil  DateTime? @map("promoted_until")
  promotionPaidAt DateTime? @map("promotion_paid_at")
  promotionPaymentMethod String? @map("promotion_payment_method")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner  User    @relation(fields: [ownerUserId], references: [id])
  jobAds JobAd[]
  payments Payment[]

  @@index([ownerUserId])
  @@index([isPromoted])
  @@index([category])
  @@map("business_listings")
}

model JobAd {
  id                String    @id @default(uuid())
  businessListingId String?   @map("business_listing_id")
  title             String
  description       String?
  location          String?
  salaryRange       String?   @map("salary_range")
  contactEmail      String?   @map("contact_email")
  closingDate       DateTime? @map("closing_date")
  isPublished       Boolean   @default(false) @map("is_published")
  publishPaidAt     DateTime? @map("publish_paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  businessListing BusinessListing? @relation(fields: [businessListingId], references: [id])
  jobApplications JobApplication[]
  payments Payment[]

  @@index([businessListingId])
  @@index([closingDate])
  @@index([isPublished])
  @@map("job_ads")
}

enum JobApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED

  @@map("job_application_status")
}

model JobApplication {
  id          String                  @id @default(uuid())
  jobAdId     String                  @map("job_ad_id")
  name        String
  email       String
  phone       String?
  coverLetter String?                 @map("cover_letter")
  cvUrl       String?                 @map("cv_url")
  status      JobApplicationStatus    @default(SUBMITTED)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  deletedAt   DateTime?               @map("deleted_at")

  jobAd JobAd @relation(fields: [jobAdId], references: [id], onDelete: Cascade)

  @@index([jobAdId])
  @@index([email])
  @@index([status])
  @@map("job_applications")
}

model ForumCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  topics ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  userId      String   @map("user_id")
  title       String
  content     String
  aiSummary   String?  @map("ai_summary")
  tags        String[] @default([])
  isFlagged   Boolean  @default(false) @map("is_flagged")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category ForumCategory @relation(fields: [categoryId], references: [id])
  user     User          @relation(fields: [userId], references: [id])
  posts    ForumPost[]

  @@index([categoryId])
  @@index([userId])
  @@map("forum_topics")
}

model ForumPost {
  id        String   @id @default(uuid())
  topicId   String   @map("topic_id")
  userId    String   @map("user_id")
  content   String
  isFlagged Boolean  @default(false) @map("is_flagged")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@index([topicId])
  @@index([userId])
  @@map("forum_posts")
}

model Fundraiser {
  id               String              @id @default(uuid())
  title            String
  description      String?
  targetAmount     Decimal             @map("target_amount") @db.Decimal(12, 2)
  raisedAmount     Decimal             @default(0) @map("raised_amount") @db.Decimal(12, 2)
  totalDonors      Int                 @default(0) @map("total_donors")
  imageUrl         String?             @map("image_url")
  imagePath        String?             @map("image_path")
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  isActive         Boolean             @default(true) @map("is_active")
  status           FundraiserStatus    @default(PENDING_APPROVAL)
  category         FundraiserCategory  @default(CHARITY)
  organizerId      String?             @map("organizer_id")
  rejectionReason  String?             @map("rejection_reason")
  approvedAt       DateTime?           @map("approved_at")
  aiSummary        String?             @map("ai_summary")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  donations  Donation[]
  updates    FundraiserUpdate[]
  photos     FundraiserPhoto[]
  organizer  User?               @relation("FundraiserOrganizer", fields: [organizerId], references: [id])

  @@index([status])
  @@index([isActive])
  @@index([endDate])
  @@index([organizerId])
  @@map("fundraisers")
}

model Donation {
  id            String    @id @default(uuid())
  fundraiserId  String    @map("fundraiser_id")
  userId        String?   @map("user_id")
  amount        Decimal   @db.Decimal(12, 2)
  paymentId     String?   @map("payment_id")
  message       String?
  displayName   String?   @map("display_name")
  isAnonymous   Boolean   @default(false) @map("is_anonymous")
  isOffline     Boolean   @default(false) @map("is_offline")
  donorEmail    String?   @map("donor_email")
  isVerified    Boolean   @default(false) @map("is_verified")
  notes         String?
  donatedAt     DateTime  @default(now()) @map("donated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  fundraiser  Fundraiser  @relation(fields: [fundraiserId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  payments    Payment[]

  @@unique([fundraiserId, paymentId])
  @@index([fundraiserId])
  @@index([userId])
  @@index([paymentId])
  @@map("donations")
}

model FundraiserUpdate {
  id           String    @id @default(uuid())
  fundraiserId String    @map("fundraiser_id")
  authorId     String    @map("author_id")
  title        String
  content      String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  fundraiser  Fundraiser  @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id])

  @@index([fundraiserId])
  @@map("fundraiser_updates")
}

model FundraiserPhoto {
  id           String   @id @default(uuid())
  fundraiserId String   @map("fundraiser_id")
  url          String
  path         String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  fundraiser Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)

  @@index([fundraiserId])
  @@map("fundraiser_photos")
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String
  authorUserId    String    @map("author_user_id")
  publishedAt     DateTime? @map("published_at")
  isPublished     Boolean   @default(false) @map("is_published")
  imageUrl        String?   @map("image_url")
  metaDescription String?   @map("meta_description")
  tags            String[]  @default([])
  galleryId       String?   @unique @map("gallery_id") @db.Text
  aiTldr          String?   @map("ai_tldr")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  author  User          @relation(fields: [authorUserId], references: [id], name: "AuthorBlogPosts")
  gallery EventGallery? @relation(fields: [galleryId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model EventGallery {
  id          String    @id @default(uuid()) @db.Text
  title       String
  slug        String    @unique
  description String?
  eventDate   DateTime? @map("event_date") @db.Timestamptz()
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  photos    EventGalleryPhoto[]
  blogPost  BlogPost?

  @@index([slug])
  @@index([isPublished])
  @@index([eventDate])
  @@map("event_galleries")
}

model EventGalleryPhoto {
  id             String   @id @default(uuid()) @db.Text
  eventGalleryId String   @map("event_gallery_id")
  url            String
  path           String?
  caption        String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  eventGallery EventGallery @relation(fields: [eventGalleryId], references: [id], onDelete: Cascade)

  @@index([eventGalleryId])
  @@map("event_gallery_photos")
}

model ContactMessage {
  id             String        @id @default(uuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String
  handledStatus  ContactStatus @default(NEW) @map("handled_status")
  aiFaqResponse  String?       @map("ai_faq_response")
  consent        Boolean       @map("consent")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  @@index([handledStatus])
  @@index([email])
  @@map("contact_messages")
}

model AiCache {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("ai_cache")
}

model SearchIndex {
  id        String   @id @default(uuid())
  entityType String  @map("entity_type")
  entityId  String   @map("entity_id")
  title     String
  content   String
  embedding String?  // Stored as JSON string for flexibility
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@map("search_index")
}

model SitePage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  isHome          Boolean  @default(false) @map("is_home")
  metaDescription String?  @map("meta_description")
  ogImageUrl      String?  @map("og_image_url")
  blocks          Json
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isHome])
  @@index([isPublished])
  @@map("site_pages")
}

model SiteSettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  facebook    String?
  instagram   String?
  twitter     String?
  youtube     String?
  linkedin       String?
  tiktok         String?
  showPageLoader Boolean? @default(true) @map("show_page_loader")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model HeroConfig {
  // The live column is a real `uuid`, not `text`. Declaring @db.Uuid aligns the
  // schema to the database so Prisma stops trying to rewrite this primary key;
  // the alternative (rewriting the column) would be a destructive no-op.
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaType           String   @default("video") @map("media_type")
  imageUrl            String?  @map("image_url")
  videoUrl            String?  @map("video_url")
  overlayStyle        String   @default("noise") @map("overlay_style")
  overlayOpacity      Int      @default(75) @map("overlay_opacity")
  videoOverlayOpacity Int      @default(75) @map("video_overlay_opacity")
  videoPlaybackRate   Float    @default(1) @map("video_playback_rate")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("hero_config")
}

model PaymentSettings {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String   @default("stripe")
  stripeSecretKey      String?  @map("stripe_secret_key")
  stripeWebhookSecret  String?  @map("stripe_webhook_secret")
  stripePublishableKey String?  @map("stripe_publishable_key")
  paypalClientId       String?  @map("paypal_client_id")
  paypalClientSecret   String?  @map("paypal_client_secret")
  paypalApiBaseUrl     String?  @map("paypal_api_base_url")
  processingFeeEnabled Boolean  @default(true) @map("processing_fee_enabled")
  processingFeePercent Decimal  @default(1.50) @db.Decimal(5, 2) @map("processing_fee_percent")
  processingFeeFixed   Int      @default(20) @map("processing_fee_fixed")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model WebhookEvent {
  id           String    @id @default(uuid())
  provider     String    // stripe, paypal
  eventType    String    @map("event_type")
  externalId   String?   @map("external_id")
  payloadHash  String    @map("payload_hash")
  status       String    // received, processed, ignored, failed
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model CommitteeMember {
  id           String    @id @default(uuid())
  name         String
  position     String
  roleKey      String    @unique @map("role_key")
  photoUrl     String?   @map("photo_url")
  photoPath    String?   @map("photo_path")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@map("committee_members")
}

enum PolicyDocumentType {
  PRIVACY_POLICY
  TERMS_CONDITIONS
  MEMBERSHIP_POLICY
  DISCLAIMER
  GDPR_POLICY
  COOKIE_POLICY

  @@map("policy_document_type")
}

model PolicyDocument {
  id          String             @id @default(uuid())
  type        PolicyDocumentType @unique
  title       String
  content     String
  isPublished Boolean            @default(false) @map("is_published")
  updatedBy   String?            @map("updated_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([type])
  @@map("policy_documents")
}

model GdprSettings {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cookieConsentEnabled    Boolean  @default(true) @map("cookie_consent_enabled")
  cookieConsentMessage    String   @default("We use cookies to improve your experience on our website. By continuing to browse, you agree to our use of cookies.") @map("cookie_consent_message")
  cookiePolicyUrl         String?  @map("cookie_policy_url")
  privacyPolicyUrl        String?  @map("privacy_policy_url")
  analyticsEnabled        Boolean  @default(false) @map("analytics_enabled")
  marketingCookiesEnabled Boolean  @default(false) @map("marketing_cookies_enabled")
  dataRetentionDays       Int      @default(365) @map("data_retention_days")
  dpoName                 String?  @map("dpo_name")
  dpoEmail                String?  @map("dpo_email")
  dpoPhone                String?  @map("dpo_phone")
  gdprNotes               String?  @map("gdpr_notes")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("gdpr_settings")
}
