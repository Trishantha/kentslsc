{
  "name": "@kentslsc/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc && cp -r prisma dist/prisma || true",
    "clean": "rm -rf dist .turbo",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "reset:admin": "dotenv -e ../../.env -- tsx src/reset-admin-password.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@kentslsc/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "bcrypt": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
