{
  "name": "@kentslsc/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc && cp -r prisma dist/prisma || true",
    "clean": "rm -rf dist .turbo",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0"
  },
  "devDependencies": {
    "@kentslsc/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "bcrypt": "^5.1.1",
    "dotenv-cli": "^7.4.0",
    "prisma": "^5.16.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
