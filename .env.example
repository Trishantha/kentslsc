# When using Supabase, use the Transaction Pooler URL and append
# pgbouncer=true&connection_limit=1 so Prisma works correctly with the pooler.
DATABASE_URL=postgresql://kentslsc:kentslsc@localhost:5432/kentslsc?schema=public&pgbouncer=true&connection_limit=1
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-very-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-secret
# Optional third-party service keys. Leave empty to disable the feature and run
# the site without AI, Stripe, or outbound email.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CARD_STORAGE_PATH=./cards
# Optional Supabase Storage configuration. When provided, file uploads go to the
# configured bucket instead of the local filesystem.
# Project URL can be found in the Supabase dashboard: https://supabase.com/dashboard/project/<ref>
SUPABASE_URL=https://mdckskhxlnnzgerqdwui.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=KentSLSC
