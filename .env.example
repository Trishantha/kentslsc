# Required: Postgres connection string.
# On IPv4-only hosts (Hostinger shared hosting), the direct connection
# db.<project-ref>.supabase.co:5432 is unreachable — Supabase direct
# connections are IPv6-only without the paid IPv4 add-on. Use the session
# pooler instead (Supabase dashboard → Settings → Database → Connection
# string → Session pooler):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler on port 6543 is NOT compatible with Prisma migrate
# deploy, which runs at startup. connection_limit keeps the pool small enough
# for the pooler's free-tier connection cap; connect_timeout (seconds) makes a
# stuck connection fail fast instead of hanging startup.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&connect_timeout=15
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-secret-at-least-32-characters
# Optional third-party service keys. Leave empty to disable the feature and run
# the site without AI, Stripe, or outbound email.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# PayPal settings. PAYPAL_API_BASE_URL must be one of the official PayPal hosts
# (sandbox or live). PAYPAL_WEBHOOK_ID is required to verify incoming PayPal
# webhook signatures and must match the webhook created in the PayPal dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# GoCardless settings (Direct Debit / open banking via Billing Request Flows).
# GOCARDLESS_ACCESS_TOKEN: sandbox access token from the GoCardless dashboard
# (Developers → API tokens). GOCARDLESS_WEBHOOK_SECRET: the secret shown when
# you register the webhook endpoint in the dashboard. GOCARDLESS_ENVIRONMENT
# is sandbox|live and defaults to sandbox.
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=sandbox
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Must be an address owned by EMAIL_USER (e.g. the same mailbox). Using a
# different From address such as noreply@ will be rejected by Hostinger.
EMAIL_FROM=
FRONTEND_URL=http://localhost:3000
# Frontend-only: set to true and redeploy/restart the Node.js app to show the
# application-level maintenance page for all public routes.
MAINTENANCE_MODE=false
# Set to true when the API runs behind a reverse proxy (Hostinger, etc.) so the
# rate limiter sees the real client IP instead of the proxy IP. Do NOT enable on
# deployments where end users can send their own X-Forwarded-For header.
# Defaults to false in all environments; set to true explicitly when the proxy
# strips or overwrites untrusted forwarding headers.
TRUST_PROXY=false
# Optional backend-only: an additional secret used for admin-level operations.
# Currently not required by the codebase, but reserved for future use.
# ADMIN_SECRET=
# Frontend-only: this is used by the forum websocket client. In production it
# must point to the public API origin (e.g. https://api.kentslsc.org). Never
# leave it unset in production or the browser will try to connect to localhost.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Backend-only: the Next.js frontend rewrites /api/* to this origin. Do NOT set
# this on the production frontend; keep it server-side only.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Redis-backed BullMQ queues for high-traffic ticket handling,
# offloaded emails, and asynchronous webhook processing. Leave unset to keep
# the current synchronous behaviour. QUEUE_ENABLED defaults to true when
# REDIS_URL is present; set it to false to disable queues even with Redis.
# REDIS_URL=redis://localhost:6379
# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5

# Optional: skip the Prisma --version probe at startup. Useful on shared hosts
# with tight process caps where spawning the Prisma CLI for a version check
# exhausts the account budget and causes startup failures (EAGAIN).
# SKIP_PRISMA_VERSION_CHECK=true

# Optional: skip database migrations at startup. Not recommended in production.
# SKIP_MIGRATIONS=true

# Optional: how long (ms) startup waits for the API and web child processes to
# accept connections. Defaults to 120000 each. Raise on throttled shared hosts
# where a cold boot can exceed two minutes, e.g. API_READY_TIMEOUT_MS=300000
# API_READY_TIMEOUT_MS=120000
# WEB_READY_TIMEOUT_MS=120000

# Hostinger hbuilds sandbox: loopback is isolated per process AND the sandbox
# exposes no routable IPv4, so the parent cannot reach a TCP-bound web child at
# all (ECONNREFUSED on 127.0.0.1, ::1 and the container IP). Under lsnode the
# server therefore serves the web child over a Unix domain socket
# (apps/web/unix-server.js) and proxies to it — the same mechanism the API
# child already uses. WEB_TRANSPORT=unix|tcp forces the choice (mainly for
# local testing); WEB_SOCKET_PATH overrides the socket location.
# WEB_TRANSPORT=unix
# WEB_SOCKET_PATH=/tmp/kslsc-web.sock
# If a future sandbox exposes a routable interface, TCP is used automatically;
# set these only to override that detection.
# INTERNAL_WEB_HOST=203.0.113.10
# WEB_BIND_HOST=0.0.0.0

# Optional frontend-only: an internal origin the frontend container can reach
# for server-side API calls such as session checks. Useful when the public
# API_PROXY_TARGET is not reachable from inside the container.
# INTERNAL_API_URL=http://localhost:3001
# Supabase Storage configuration. Required in production so images, videos and
# generated membership cards are stored in the cloud instead of the local filesystem.
# Project URL can be found in the Supabase dashboard: https://supabase.com/dashboard/project/<ref>
# SUPABASE_SERVICE_KEY must be the service_role (secret) key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=KentSLSC

# Optional Facebook page feed integration. When both are set, the API will
# periodically sync the page's posts and merge them into the public blog feed.
# Get a Page Access Token from the Facebook App dashboard after creating an app
# at https://developers.facebook.com and granting it pages_read_engagement.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Emergency admin account recovery / creation (backend only).
# Set this in the production backend environment and restart the API to either:
#   - create an admin account for ADMIN_EMERGENCY_EMAIL if it does not exist, or
#   - reset the password and clear lockout for that account if it already exists.
# Remove it immediately after logging in and change the password from the admin UI.
# Never commit a real value here.
# ADMIN_EMERGENCY_PASSWORD=
# ADMIN_EMERGENCY_EMAIL=
