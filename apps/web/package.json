{
  "name": "@kentslsc/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2560' PORT=${PORT:-3000} next dev",
    "dev:clean": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=2560' PORT=${PORT:-3000} next dev",
    "dev:turbo": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=2560' PORT=${PORT:-3000} next dev --turbo",
    "build": "NODE_OPTIONS='--max-old-space-size=2560' next build",
    "build:clean": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=2560' next build",
    "clean": "rm -rf .next .turbo",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@kentslsc/config": "workspace:*",
    "@kentslsc/shared": "workspace:*",
    "@stripe/react-stripe-js": "^3.6.0",
    "@stripe/stripe-js": "^7.0.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.30.0",
    "next": "15.5.21",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "sanitize-html": "^2.17.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@kentslsc/config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
